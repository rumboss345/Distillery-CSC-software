# Admin account (created on first server start if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Required in production (Render environment variables)
JWT_SECRET=generate-a-long-random-string
APP_URL=https://your-service.onrender.com

# Local development only
AUTH_PORT=3001

# Default password for npm run seed:test-employees (four @csc.test accounts)
# TEST_EMPLOYEE_PASSWORD=TestEmployee1!

# Email (optional — without SMTP, approval links are printed to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CSC Distillery Tracker <admin@example.com>

# Ask Nelly — optional OpenAI-compatible API for conversational answers
# (Without a key, staff still get ranked IBD excerpt answers.)
# ASK_NELLY_OPENAI_API_KEY=
# ASK_NELLY_MODEL=gpt-4o-mini
# ASK_NELLY_OPENAI_BASE_URL=https://api.openai.com/v1
