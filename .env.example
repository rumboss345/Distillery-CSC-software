# Admin account (created on first server start if missing)
ADMIN_EMAIL=nelson@rum.ky
ADMIN_PASSWORD=change-me-in-production

# Required in production (Render environment variables)
JWT_SECRET=generate-a-long-random-string
APP_URL=https://your-service.onrender.com

# Local development only
AUTH_PORT=3001

# Email (optional — without SMTP, approval links are printed to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Distillery Traker3 <nelson@rum.ky>
