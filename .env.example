# Admin account (created on first server start if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Required in production (Render environment variables)
JWT_SECRET=generate-a-long-random-string
APP_URL=https://your-service.onrender.com

# Local development only
AUTH_PORT=3001

# PostgreSQL — OPTIONAL during testing; required only when enabling central database migration
# Omit DATABASE_URL to run with browser-local production data and SQLite auth.
# Local PostgreSQL: docker compose up -d
# DATABASE_URL=postgresql://csc:csc_dev_password@localhost:5432/csc_distillery

# Email (optional — without SMTP, approval links are printed to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CSC Distillery Tracker <admin@example.com>
